{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "traits"],
  "additionalProperties": true,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "description": {"type": "string"},
    "folder": {"type": "string"},
    "traits": {
      "type": "array",
      "items": {"enum": ["indexed", "temporal", "stateful", "procedural", "cited", "raw", "log"]}
    },
    "max_tokens": {"type": "integer", "minimum": 1},
    "max_claims": {"type": "integer", "minimum": 1, "maximum": 20},
    "staleness_days": {"type": "integer", "minimum": 1},
    "claim_rules": {"type": "object"},
    "fields": {"type": "object"}
  }
}
