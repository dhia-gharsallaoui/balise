# Copy to .env (or export these directly) and fill in what you need.
# `make up`/`make expose` read BALISE_* out of the environment; the CLI's own
# --flags (see `balise <command> --help`) always override whatever is set here.

# Postgres connection string. The default below assumes Postgres already on the
# standard 5432.
#
# If you do not have one, `docker compose up -d` starts a matching instance with
# this exact role/db/password -- but it publishes on **5433**, not 5432, so that
# it cannot collide with a system Postgres. Using compose means changing the port
# here, or the first connection fails with "connection refused" for a reason that
# is not obvious:
#
#   BALISE_DSN=postgresql://balise:balise@localhost:5433/balise
BALISE_DSN=postgresql://balise:balise@localhost:5432/balise

# Owner password gating /api. Only required when the API binds to a
# non-loopback address (`make expose`, or --addr on `balise serve`) — plain
# `make up` on loopback works fine with this left empty. See
# cmd/balise/main.go's requirePasswordForNonLoopback for why that's enforced.
BALISE_PASSWORD=

# Comma-separated hostnames Vite's dev server will accept as a Host header
# when the web UI is bound to a non-loopback interface (`make expose`).
# Vite rejects any other Host as a DNS-rebinding guard. The literal value
# "all" disables the check entirely; `make expose` defaults to that when
# this is left unset.
BALISE_ALLOWED_HOSTS=

# Extra CORS origins to allow beyond the API's own default same-origin
# assumption, comma-separated. Usually unnecessary — the web UI reaches the
# API through Vite's same-origin proxy, not cross-origin.
BALISE_EXTRA_ORIGINS=

# Bearer token used by `balise mcp <vault> --stdio` when --token is not
# passed on the command line. Prefer this over --token: a flag value is
# visible via `ps` and shell history, an env var is not.
BALISE_MCP_TOKEN=

# Anthropic API access, used by `balise compile extract-claims` (LLM-assisted
# claim maintenance). ANTHROPIC_BASE_URL only needs setting to point at a
# non-default (e.g. proxied or self-hosted) endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- Testing only ---

# Overrides the password Playwright's own dev server uses for e2e tests
# (web/playwright.config.ts); leave unset to use its built-in default.
# BALISE_TEST_PASSWORD=

# A real Claude Code memory directory and its factory-validation/out sibling,
# used only by internal/cli's acceptance tests against real corpus data.
# Unset (the default): those tests are skipped rather than failed.
# BALISE_ACCEPTANCE_CORPUS=
# BALISE_ACCEPTANCE_ARTIFACTS=

# Postgres DSN used by Go tests (internal/testutil), separate from BALISE_DSN
# so a test run never touches a real dev database by accident.
# BALISE_TEST_DSN=postgresql://balise:balise@localhost:5432/balise
