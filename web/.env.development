# VITE_API_BASE is deliberately left unset here. src/lib/api.ts falls back to "" (relative
# /api paths) when it's absent, so requests stay same-origin and go through the /api proxy
# defined in vite.config.ts (dev server -> 127.0.0.1:8099). Setting it to an absolute backend
# URL bypasses that proxy, makes requests cross-origin, and reintroduces CORS failures.
